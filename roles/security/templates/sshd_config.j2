# Managed by Ansible — roles/security. Do not edit by hand.
Port {{ ssh_port }}
Protocol 2
AddressFamily inet

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*

AllowUsers {{ allowed_ssh_users | join(' ') }}

ClientAliveInterval 300
ClientAliveCountMax 2
LoginGraceTime 20
MaxAuthTries 3
MaxSessions 4

Subsystem sftp /usr/lib/openssh/sftp-server
